<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="550"
        Width="450" Height="600"
        x:Class="MiPresentacion.MainWindow"
        Title="MiPresentacion">

    <StackPanel Margin="20" Spacing="15">
        <!-- Título -->
        <TextBlock Text="Mi primera aplicación gráfica"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <!-- Campo Nombre -->
        <StackPanel Spacing="5">
            <TextBlock Text="Nombre:" />
            <TextBox x:Name="TxtNombre" Watermark="Ingrese su nombre" />
        </StackPanel>

        <!-- Campo Apellido -->
        <StackPanel Spacing="5">
            <TextBlock Text="Apellido:" />
            <TextBox x:Name="TxtApellido" Watermark="Ingrese su apellido" />
        </StackPanel>

        <!-- Campo Edad -->
        <StackPanel Spacing="5">
            <TextBlock Text="Edad:" />
            <TextBox x:Name="TxtEdad" Watermark="Ingrese su edad numérica" />
        </StackPanel>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button x:Name="BtnPresentarme" Content="Presentarme" Click="BtnPresentarme_Click" Width="110" />
            <Button x:Name="BtnLimpiar" Content="Limpiar" Click="BtnLimpiar_Click" Width="90" />
            <Button x:Name="BtnCambiarSaludo" Content="Cambiar saludo" Click="BtnCambiarSaludo_Click" Width="120" />
        </StackPanel>

        <!-- Resultado -->
        <Border Background="#F2F2F2" Padding="15" CornerRadius="6" Margin="0,10,0,0">
            <TextBlock x:Name="TxtResultado"
                       Text="Aquí aparecerá tu presentación o mensajes de validación..."
                       TextWrapping="Wrap"
                       FontStyle="Italic"
                       Foreground="Black" />
        </Border>
    </StackPanel>
</Window>